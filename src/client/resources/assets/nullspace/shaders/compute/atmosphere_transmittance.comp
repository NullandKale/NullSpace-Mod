#version 430
#include "space.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) writeonly uniform image2D Result;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy), size = imageSize(Result);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = vec2(pixel) / vec2(size - 1);
    float r = AtmoRadius + max(.0001, uv.y * uv.y * AtmoHeight);
    float horizon = -sqrt(max(0., 1. - AtmoRadius * AtmoRadius / (r * r)));
    float mu = horizon + (1. - horizon) * uv.x * uv.x;
    vec3 p = vec3(0, r, 0), d = vec3(sqrt(max(0., 1. - mu * mu)), mu, 0);
    float distance = atmoSphere(p, d, AtmoRadius + AtmoHeight).y;
    vec3 optical = vec3(0);
    for (int i = 0; i < 128; i++) {
        float t = (float(i) + .5) / 128.;
        // Quadratic spacing resolves the dense layer close to a surface observer.
        float ds = distance * 2. * t / 128.;
        optical += atmoExtinction(length(p + d * (distance * t * t)) - AtmoRadius) * ds;
    }
    imageStore(Result, pixel, vec4(exp(-optical), 1));
}
