#version 430
#include "space.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) writeonly uniform image2D Result;
layout(rgba16f, binding = 1) writeonly uniform image2D Transmission;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy), size = imageSize(Result);
    if (any(greaterThanEqual(pixel, size))) return;
    vec3 d = skyLutRay((vec2(pixel) + .5) / vec2(size));
    vec3 L = vec3(0), T = vec3(1);
    atmoIntegrate(d, 0., FAR, 24, CloudSteps, L, T);
    if (atmoGround(-AtmoCenter, d)) T = vec3(0);
    imageStore(Result, pixel, vec4(max(L, vec3(0)), 1));
    imageStore(Transmission, pixel, vec4(clamp(T, 0., 1.), 1));
}
