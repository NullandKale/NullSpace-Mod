#version 430
#include "space.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) writeonly uniform image2D Result;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy), size = imageSize(Result);
    if (any(greaterThanEqual(pixel, size))) return;
    vec2 uv = vec2(pixel) / vec2(size - 1);
    float r = AtmoRadius + max(.0001, uv.y * uv.y * AtmoHeight);
    float mu = uv.x * 2. - 1.;
    vec3 p = vec3(0, r, 0), sun = vec3(sqrt(max(0., 1. - mu * mu)), mu, 0);
    vec3 single = vec3(0), feedback = vec3(0);
    for (int direction = 0; direction < 24; direction++) {
        float z = 1. - 2. * (float(direction) + .5) / 24.;
        float angle = float(direction) * 2.39996323;
        vec3 d = vec3(cos(angle) * sqrt(1. - z * z), z, sin(angle) * sqrt(1. - z * z));
        vec2 span = atmoSphere(p, d, AtmoRadius + AtmoHeight);
        vec2 ground = atmoSphere(p, d, AtmoRadius);
        bool groundHit = ground.x > .0001;
        float distance = groundHit ? min(span.y, ground.x) : span.y;
        vec3 T = vec3(1), L = vec3(0), F = vec3(0);
        float ds = max(0., distance) / 32.;
        for (int step = 0; step < 32; step++) {
            vec3 q = p + d * ((float(step) + .5) * ds);
            float h = length(q) - AtmoRadius;
            vec3 rho = atmoDensities(h);
            vec3 sigma = atmoExtinction(h), scatter = AtmoRayleigh * rho.x + AtmoMie * rho.y;
            vec3 a = exp(-sigma * ds), integral = (1. - a) / max(sigma, vec3(1e-8));
            L += T * scatter * atmoTrans(q, sun) * integral / (4. * PI);
            F += T * scatter * integral;
            T *= a;
        }
        if (groundHit) {
            vec3 q = p + d * distance;
            L += T * AtmoAlbedo * max(0., dot(normalize(q), sun)) * atmoTrans(q + normalize(q) * .001, sun) / PI;
        }
        single += L / 24.; feedback += F / 24.;
    }
    // Isotropic higher orders form a bounded geometric series (Hillaire's factorization).
    imageStore(Result, pixel, vec4(single / max(vec3(.03), 1. - feedback), 1));
}
