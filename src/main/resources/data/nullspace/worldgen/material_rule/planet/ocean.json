{
  "type": "minecraft:sequence",
  "sequence": [
    "minecraft:bedrock_floor",
    "minecraft:overworld/copper_ore_vein",
    "minecraft:overworld/iron_ore_vein",
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:above_preliminary_surface"
      },
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:biome",
              "biome_is": [
                "nullspace:planet/ocean_mushroom_fields"
              ]
            },
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": "minecraft:on_floor",
                  "then_run": {
                    "type": "minecraft:sequence",
                    "sequence": [
                      {
                        "type": "minecraft:condition",
                        "if_true": "minecraft:not_underwater",
                        "then_run": {
                          "type": "minecraft:block",
                          "result_state": "minecraft:mycelium"
                        }
                      },
                      {
                        "type": "minecraft:block",
                        "result_state": "minecraft:dirt"
                      }
                    ]
                  }
                },
                {
                  "type": "minecraft:condition",
                  "if_true": "minecraft:under_floor",
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "minecraft:dirt"
                  }
                }
              ]
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": "minecraft:on_floor",
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": "minecraft:not_underwater",
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "minecraft:sand"
                  }
                },
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:noise_threshold",
                    "noise": "minecraft:surface",
                    "min_threshold": 0.3,
                    "max_threshold": 10
                  },
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "minecraft:gravel"
                  }
                },
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:noise_threshold",
                    "noise": "minecraft:surface",
                    "min_threshold": -10,
                    "max_threshold": -0.6
                  },
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "minecraft:clay"
                  }
                },
                {
                  "type": "minecraft:block",
                  "result_state": "minecraft:sand"
                }
              ]
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": "minecraft:under_floor",
            "then_run": {
              "type": "minecraft:block",
              "result_state": "minecraft:sandstone"
            }
          }
        ]
      }
    },
    "minecraft:overworld/underground"
  ]
}
